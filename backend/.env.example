# Bu dosya bir ÖRNEKTİR. Kopyalayıp adını ".env" yapın ve değerleri doldurun.
# .env dosyası GitHub'a yüklenmez (.gitignore'da), gizli bilgiler böyle korunur.

# --- VERİTABANI (opsiyonel) ---
# Doldurursanız PostgreSQL kullanılır (örn. Render'daki veritabanı).
# BOŞ BIRAKIRSANIZ otomatik olarak yerel SQLite (backend/trello.db) kullanılır,
# yani hiçbir kurulum yapmadan proje çalışır.
DATABASE_URL=

# --- JWT GİZLİ ANAHTARI (önerilir) ---
# Giriş token'larını imzalamak için kullanılır. Uzun ve rastgele olmalı.
# Üretmek için: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# --- PORT (opsiyonel) ---
# Boş bırakılırsa 3000 kullanılır. Render bu değeri kendisi verir.
PORT=3000
